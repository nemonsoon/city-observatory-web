# このファイルが環境変数の正典。`.env.local` にコピーして値を入れる。
# 検証は lib/env.ts の Zod スキーマが行う。必須が欠けると起動時に落ちる。

# --- 必須 ---

# MapTiler の API キー。地図タイルの取得に使う
# 取得: https://cloud.maptiler.com/account/keys/
NEXT_PUBLIC_MAPTILER_KEY=your_maptiler_api_key

# OpenWeatherMap の API キー。地図に重ねる降水レイヤーに使う
# 取得: https://home.openweathermap.org/api_keys
NEXT_PUBLIC_OPENWEATHER_KEY=your_openweather_api_key

# --- 任意 ---

# 明るい配色のときの地図スタイル。未設定なら MapTiler dataviz を使う
NEXT_PUBLIC_MAP_STYLE_LIGHT=https://api.maptiler.com/maps/dataviz/style.json

# 暗い配色のときの地図スタイル。未設定なら MapTiler dataviz-dark を使う
NEXT_PUBLIC_MAP_STYLE_DARK=https://api.maptiler.com/maps/dataviz-dark/style.json

# 最初に表示する都市。未設定なら tokyo
NEXT_PUBLIC_DEFAULT_CITY=tokyo
